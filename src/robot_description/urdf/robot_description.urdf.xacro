<?xml version ="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="robotic_arm">


    <!-- PODSTAWA - BASE LINK -->
<link name="base_link">
    <visual>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <geometry>
            <box size="0.3 0.3 0.1"/>
        </geometry>
        <material name="grey">
            <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
    </visual>

    <collision>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <geometry>
            <box size="0.3 0.3 0.1"/>
        </geometry>
    </collision>
</link>


<link name="rotating_base">
    <visual>
       
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
        <geometry>
            <cylinder radius="0.1" length="0.2"/>
        </geometry>
        <material name="blue">
            <color rgba="0.1 0.3 0.9 1.0"/>
        </material>
    </visual>

    <collision>
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
        <geometry>
            <cylinder radius="0.1" length="0.2"/>
        </geometry>
    </collision>
</link>

     <!-- Połączenie podstawy z ramieniem -->

  <joint name="shoulder_joint" type="revolute">
        <parent link="base_link"/>
        <child link="rotating_base"/>

        <origin xyz="0 0 0.1" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>


        <limit
        lower="-3.14159"
        upper="3.14159"
        effort="10.0"
        velocity="1.0"/>
        
    </joint>

</robot>